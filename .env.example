API_KEY=change-me

# Seul paramètre applicatif obligatoire.
MODEL_ID=BAAI/bge-m3

# Alias optionnels exposés aux clients OpenAI.
# MODEL_ALIAS=mon-modele
# SERVED_MODEL_NAME=mon-modele

# HF_TOKEN=hf_xxx

# Tous les paramètres vLLM ci-dessous sont optionnels. En leur absence, vLLM
# choisit ses valeurs par défaut à partir du modèle et du matériel.
# RUNNER=pooling
# TRUST_REMOTE_CODE=0
# MAX_MODEL_LEN=8192
# GPU_MEMORY_UTILIZATION=0.10
# MAX_NUM_SEQS=64
# MAX_NUM_BATCHED_TOKENS=32768

# DTYPE=auto
# ENFORCE_EAGER=0
# DISABLE_LOG_REQUESTS=0

# À tester seulement si repo/model compatible quantization.
# QUANTIZATION=fp8

# Peu utile pour embeddings encoder ; pas recommandé par défaut.
# KV_CACHE_DTYPE=fp8

# Seulement si mismatch FlashInfer.
# FLASHINFER_DISABLE_VERSION_CHECK=1

# Cache HF local au projet.
# HF_HOME=/home/ailab/api-embedding/.cache/huggingface
# HF_HUB_ENABLE_HF_TRANSFER=1
