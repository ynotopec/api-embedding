# Backend:
# vllm = OpenAI-compatible rapide pour embeddings denses
# flagembedding = meilleur support BGE-M3 complet dense/sparse/ColBERT
BACKEND=vllm

MODEL_ID=BAAI/bge-m3
SERVED_MODEL_NAME=BAAI/bge-m3

# Token API. Si vide: pas d'auth.
API_KEY=change-me

# Installation
# INSTALL_VLLM=1
# VLLM_VERSION=

# vLLM
# VLLM_TASK=embed
# VLLM_DTYPE=auto
# MAX_MODEL_LEN=8192
# GPU_MEMORY_UTILIZATION=0.35
# TRUST_REMOTE_CODE=0

# FlagEmbedding fallback
# BATCH_SIZE=8
# USE_FP16=1
# DEVICE=cuda
# RETURN_SPARSE=0
# RETURN_COLBERT=0

# Hugging Face
# HF_HOME=/home/ailab/.cache/huggingface
# HF_TOKEN=
# HF_HUB_ENABLE_HF_TRANSFER=1

# Runtime
# HOST=0.0.0.0
# PORT=8000
# LOG_LEVEL=info
