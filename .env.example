API_KEY=change-me

MODEL_ID=BAAI/bge-m3
# Alias exposé via API (ex: côté clients OpenAI).
MODEL_ALIAS=BAAI/bge-m3
# Optionnel: force le nom servi (prioritaire sur MODEL_ALIAS).
# SERVED_MODEL_NAME=BAAI/bge-m3

# HF_TOKEN=hf_xxx

# BGE-M3 officiel : 1024 dims / 8192 tokens.
MAX_MODEL_LEN=8192

# Safe DGX Spark / cohabitation avec autres services.
GPU_MEMORY_UTILIZATION=0.10
MAX_NUM_SEQS=64
MAX_NUM_BATCHED_TOKENS=32768

# Defaults.
# DTYPE=auto
# ENFORCE_EAGER=0
# DISABLE_LOG_REQUESTS=1

# À tester seulement si repo/model compatible quantization.
# QUANTIZATION=fp8

# Peu utile pour embeddings encoder ; pas recommandé par défaut.
# KV_CACHE_DTYPE=fp8

# Seulement si mismatch FlashInfer.
# FLASHINFER_DISABLE_VERSION_CHECK=1

# Cache HF local au projet.
# HF_HOME=/home/ailab/api-embedding/.cache/huggingface
# HF_HUB_ENABLE_HF_TRANSFER=1
